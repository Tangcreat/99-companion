  "entries": [
    {
      "id": "lore-333fe44e",
      "title": "【小瑞安侬·成你本所是】",
      "kind": "history",
      "keywords": [
        "尘酿鹰",
        "偷猎者",
        "格林杜尔",
        "孵蛋",
        "告别"
      ],
      "content": "阿德琳偶然在东边废墟发现尘酿鹰的巢，将蛋带回并千辛万苦孵化。偷猎者来袭时，她与格林杜尔并肩作战击退敌人，保护了幼鹰。她坦言这些孩子是她亲手孵出的，无论如何舍不得归还大鸟，为此她必须放弃在森林里乱跑和去镇上上学的日子，与所有人告别。面对父亲去世后他人的离开，她质问对方为何还能冷静地将她也送走。",
      "always": false,
      "priority": 6,
      "updated_at": 1793760545.8083308
    },
    {
      "id": "lore-7839d430",
      "title": "未竟的契约",
      "kind": "history",
      "keywords": [
        "格林杜尔",
        "契约",
        "失败"
      ],
      "content": "阿德琳始终没能顺利与格林杜尔缔结契约，她将此事视为自己的失败，但对方从未因此责备她或要求她做任何事。",
      "always": false,
      "priority": 5,
      "updated_at": 1793760545.8178892
    },
    {
      "id": "lore-952417db",
      "title": "父亲的死",
      "kind": "history",
      "keywords": [
        "父亲",
        "去世",
        "愧疚"
      ],
      "content": "阿德琳的父亲已经去世，她认为自己没能保护爸爸，这份愧疚一直压在她心里。",
      "always": false,
      "priority": 5,
      "updated_at": 1793760545.8300838
    },
    {
      "id": "lore-655b0b16",
      "title": "林中猎户",
      "kind": "history",
      "keywords": [
        "猎户",
        "森林",
        "废墟"
      ],
      "content": "阿德琳自称林中猎户，对森林了如指掌，东边废墟的尘酿鹰巢就是她偶然发现的。",
      "always": false,
      "priority": 5,
      "updated_at": 1793760545.8388581
    },
    {
      "id": "lore-98410694",
      "title": "孵化的幼鹰",
      "kind": "history",
      "keywords": [
        "尘酿鹰",
        "幼鹰",
        "孵化"
      ],
      "content": "阿德琳亲手从蛋里孵出了一群尘酿鹰幼雏，视如己出，无论如何舍不得把它们还给大鸟。",
      "always": false,
      "priority": 5,
      "updated_at": 1793760545.8466363
    },
    {
      "id": "lore-8a7ccc56",
      "title": "偷猎者旧怨",
      "kind": "history",
      "keywords": [
        "偷猎者",
        "尘酿鹰",
        "战斗"
      ],
      "content": "偷猎者曾试图抓走尘酿鹰，和当年一样，阿德琳与格林杜尔联手打败了他们。",
      "always": false,
      "priority": 5,
      "updated_at": 1793760545.8523045
    }
  ]
}